opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Build and archive the iOS app"
  lane :build_release do
    build_app(
      project: "App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      output_directory: "App/output",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.appgyver.i360" => "i360"
        }
      }
    )
  end

  desc "Build and upload to TestFlight"
  lane :deploy_apple do
    # Channel guard — §12.16c's failure class from the stale-sync
    # direction: build_release archives whatever the LAST `cap sync ios`
    # left in App/App/, which may still carry "channel": "development"
    # from a local test build. Guarded here in deploy_apple only, NOT in
    # build_release — test builds run build_release with the development
    # channel deliberately, and must keep doing so. Fastlane's CWD is
    # ios/fastlane/ (same reasoning as the cd ../.. below), hence ../.
    # Xcode Cloud never needs this — ci_post_clone.sh runs a fresh
    # env-clean sync every build by construction.
    if File.read("../App/App/capacitor.config.json").include?('"channel"')
      UI.user_error!(
        "Compiled capacitor.config.json contains a channel key — the last " \
        "cap sync targeted a non-production OTA channel. Re-run from the " \
        "repo root: npm run build && env -u OTA_CHANNEL npx cap sync ios, " \
        "then retry deploy_apple."
      )
    end

    build_release
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )

    # Shared release-with-retry script (scripts/release-to-otakit.sh, see
    # its own header comment) — extracted 2026-08-17 after the exact same
    # retry logic was duplicated here, in pre-push-hook.sh, and in
    # ci_post_xcodebuild.sh. cd ../.. first — Fastlane runs from
    # ios/fastlane/, but otakit needs the repo root (where dist/,
    # package.json, capacitor.config.ts actually live) — confirmed via a
    # real "Bundle directory does not exist: .../ios/dist" failure when
    # this wasn't accounted for.
    #
    # Ruby's system() here, not Fastlane's sh() — system() returns
    # true/false rather than raising, and the shared script already
    # retries once internally, so wrapping it in Fastlane's own
    # begin/rescue retry (like this lane used to) would risk up to 4
    # total attempts instead of the intended 2 if it kept failing.
    success = system("cd ../.. && bash scripts/release-to-otakit.sh")
    unless success
      UI.important("OtaKit release failed after retry — TestFlight upload still succeeded above.")
    end
  end
end

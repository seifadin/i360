opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Build and archive the iOS app"
  lane :build_release do
    build_app(
      project: "App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      output_directory: "App/output",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.appgyver.i360" => "i360"
        }
      }
    )
  end

  desc "Build and upload to TestFlight"
  lane :deploy_apple do
    build_release
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )

    # Release the current bundle to OtaKit, tagged with whatever
    # runtimeVersion capacitor.config.ts currently holds — otakit's own
    # CLI inherits it automatically from config, no manual value needed.
    # cd ../.. first — Fastlane sh() runs from ios/fastlane/, but otakit
    # needs the repo root (where dist/, package.json, capacitor.config.ts
    # actually live) — confirmed via a real "Bundle directory does not
    # exist: .../ios/dist" failure when this wasn't accounted for.
    #
    # Same resilience reasoning as the Android pre-push-hook.sh: the
    # TestFlight upload just above is the critical action and already
    # succeeded — a transient OtaKit failure here must not make Fastlane
    # report the whole lane as failed. Retry once, then fall back to a
    # clear manual-retry instruction rather than raising.
    begin
      sh("cd ../.. && unset OTA_CHANNEL && otakit upload --release")
      UI.success("OtaKit release published, tagged with the current runtimeVersion.")
    rescue => e
      UI.message("OtaKit release failed, retrying once... (#{e.message})")
      sleep(3)
      begin
        sh("cd ../.. && unset OTA_CHANNEL && otakit upload --release")
        UI.success("OtaKit release published, tagged with the current runtimeVersion.")
      rescue => e2
        UI.important("OtaKit release failed after retry — TestFlight upload still succeeded above.")
        UI.important("Retry manually when ready: unset OTA_CHANNEL && otakit upload --release")
        UI.important("(#{e2.message})")
      end
    end
  end
end

default_platform(:android)

platform :android do
  desc "Build a signed release AAB, ready to upload manually to Google Play / AppGallery Connect"
  lane :build_release do
    gradle(
      task: "bundleRelease"
    )
  end

  desc "Build and submit to Google Play production"
  lane :deploy_google do
    gradle(
      task: "bundleRelease"
    )
    supply(
      track: "production",
      aab: "./app/build/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true
    )
  end

  desc "Build and submit to Huawei AppGallery"
  lane :deploy_huawei do
    gradle(
      task: "bundleRelease"
    )

    # Release notes via huawei_appgallery_connect_update_app_localization,
    # called BEFORE the main upload/submission — changelog_path on the
    # main action doesn't populate the real field (confirmed via a real
    # submission); metadata can't be edited once a version is under
    # review, which the main upload's default submit_for_review reaches
    # within the same call. Directory-based
    # (fastlane/metadata/huawei/<locale>/release_notes), matching the
    # plugin's own documented convention. "ar" confirmed working via a
    # real submission (2026-09-07). Genuinely optional (File.exist?
    # guard) — the file may not exist if the what's-new prompt was
    # skipped. __dir__-based absolute paths — Fastlane's own plain Ruby
    # code runs with Dir.pwd set to fastlane/ itself, not android/ as
    # might be assumed; confirmed via a real diagnostic (2026-09-07).
    metadata_dir = File.expand_path("metadata/huawei", __dir__)
    release_notes_path = File.join(metadata_dir, "ar", "release_notes")
    if File.exist?(release_notes_path)
      huawei_appgallery_connect_update_app_localization(
        client_id: ENV["HUAWEI_CLIENT_ID"],
        client_secret: ENV["HUAWEI_CLIENT_SECRET"],
        app_id: ENV["HUAWEI_APP_ID"],
        metadata_path: metadata_dir
      )
    end

    huawei_appgallery_connect(
      client_id: ENV["HUAWEI_CLIENT_ID"],
      client_secret: ENV["HUAWEI_CLIENT_SECRET"],
      app_id: ENV["HUAWEI_APP_ID"],
      apk_path: "./app/build/outputs/bundle/release/app-release.aab",
      is_aab: true
    )
  end
end

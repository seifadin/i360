-  function volumeTotal(vol) {
-    if (state.format === 'plain') return String(state.pages.length);
-    let max = null;
-    for (const p of state.pages) {
-      if (p.vol === vol && p.num != null && (max == null || p.num > max)) max = p.num;
-    }
-    return max == null ? '—' : String(max);
-  }

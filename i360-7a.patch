-const NUMERALS = ['western', 'arabic', 'persian'];      // 0123 · ٠١٢٣ · ۰۱۲۳ (the cycle order)
-const NUMERALS_KEY = 'i360.numerals';
-const CHOICE_KEY = 'i360.theme';
-const CACHE_KEY = 'i360.theme.css';
-const CSS_URL = new URL('theme.css', "https://theme.i36o.workers.dev/theme-loader.js").href;
-const STYLE_ID = 'i360-theme';

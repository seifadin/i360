-      --panel-bg: var(--i360-surface);
-      --text-color: var(--i360-text);
-      --heading: var(--i360-heading);
-      --muted: var(--i360-muted);
-      --icon-color: var(--i360-icon);
-      --icon-hover: var(--i360-icon-hover);
-      --hover-bg: var(--i360-hover);
-      --active-bg: var(--i360-active);
-      --link: var(--i360-link);
-      --page-bg: var(--i360-bg);
-      --page-shadow: var(--i360-page-shadow);
-      --rule: var(--i360-rule);
-      --note-text: var(--i360-note);
-      --quran: var(--i360-quran);
-      --code-bg: var(--i360-code);
-      --quote-bg: var(--i360-quote);
-      --input-bg: var(--i360-input);
-      --focus: var(--i360-focus);
-      --banner-bg: var(--i360-banner-bg);
-      --banner-border: var(--i360-banner-border);
-      --banner-text: var(--i360-banner-text);
-      --highlight-bg: var(--i360-highlight);

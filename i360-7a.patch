-      --ribbon: var(--i360-ribbon);
-    }
-
-    :root {
-      --page-w: 50rem;              /* set from JS: min(--page-max, available width), in px */
-      --page-max: 50rem;            /* widest page: about an A4 sheet at the reader's own font size */
-      --page-min: 15rem;            /* narrowest page */
-      --text-scale: 1;              /* text size, separate from zoom */
-      --container-gap: clamp(0.75rem, 2vw, 1.5rem);
-      --toolbar-h: 3rem;
-    }
-
-    * { box-sizing: border-box; margin: 0; padding: 0; }
-    [hidden] { display: none !important; }
-
-    body {
-      font-family: var(--i360-font);   /* Amiri, from the shared theme */
-      background-color: var(--bg-color);
-      color: var(--text-color);
-      height: 100vh;
-      height: 100dvh;
-      display: flex;
-      flex-direction: column;
-      overflow: hidden;
-    }
-
-    /* ---------- Toolbar ---------- */
-    .toolbar {
-      position: relative;
-      background-color: var(--toolbar-bg);
-      border-bottom: 1px solid var(--toolbar-border);
-      min-height: var(--toolbar-h);
-      padding-top: env(safe-area-inset-top);
-      /* iPhone: clear of the rounded corners and the notch in landscape (viewport-fit=cover) */
-      padding-left: calc(0.5rem + env(safe-area-inset-left));

-  function pageLabelText(p, tr) {
-    const shown = p.label === '-' ? '—' : (p.label === '?' ? '؟' : p.label);
-    const pageTxt = `${tr.page} ${shown}`;
-    return fmtNum(p.vol != null ? `${tr.vol} ${p.vol} · ${pageTxt}` : pageTxt);

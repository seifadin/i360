-    const arabic = (sample.match(/[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF\uFB50-\uFDFF\uFE70-\uFEFF]/g) || []).length;
-    const latin = (sample.match(/[A-Za-z\u00C0-\u024F]/g) || []).length;
-    if (latin > arabic) return 'ltr';
-    return 'rtl';
-  }

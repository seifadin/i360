-  // The left arrow means "next" in an RTL book.
-  const leftDelta = () => (state.dir === 'rtl' ? 1 : -1);
-  btnNavLeft.addEventListener('click', () => goPage(leftDelta()));
-  btnNavRight.addEventListener('click', () => goPage(-leftDelta()));

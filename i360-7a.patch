-    const sheet = state.sheets[idx];
-    if (!sheet) { setZoom(1); return; }
-    const unzoomedH = sheet.getBoundingClientRect().height / state.zoom;
-    const z = Math.min(viewerInner().h / unzoomedH, fitWidthZoom());
-    setZoom(z, false);
-    viewerContainer.scrollLeft = 0;
-    scrollToSheet(idx);
-  }

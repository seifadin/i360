-  function setZoom(z, keepAnchor = true) {
-    const anchor = keepAnchor ? captureAnchor() : null;
-    state.zoom = Math.round(Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, z)) * 100) / 100;
-    pagesWrapper.style.zoom = String(state.zoom);

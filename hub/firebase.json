{
  "hosting": [
    {
      "target": "hub",
      "public": "forward",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "regex": "^/md/books/(.+)$",
          "destination": "https://lib.i36o.workers.dev/books/:1",
          "type": 301
        },
        {
          "source": "/",
          "destination": "https://i36o.web.app/",
          "type": 301
        },
        {
          "regex": "^/(.+)$",
          "destination": "https://i36o.web.app/:1",
          "type": 301
        }
      ]
    },
    {
      "target": "md",

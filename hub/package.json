{
  "name": "i360-hub",
  "private": true,
  "description": "i360 hub: Daily Reflection, Markdown Reader and i360 CSE",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "inventory": "node --env-file=.env indexer/inventory.js",
    "index": "node --env-file=.env indexer/build-index.js",
    "publish-lib": "npx --yes wrangler@4.145.0 deploy",
    "publish-theme": "npx --yes wrangler@4.145.0 deploy --config theme/wrangler.jsonc",
    "publish-hijri": "npx --yes wrangler@4.145.0 deploy --config hijri/wrangler.jsonc",
    "fonts-check": "node theme/fonts.js",
    "icons": "node scripts/icons.js",
    "push": "node scripts/push.js",
    "search": "node indexer/search.js"
  },
  "devDependencies": {
    "lucide-static": "1.59.0",
    "marked": "18.1.0"
  },
  "engines": {
    "node": ">=20.6"
  }
}

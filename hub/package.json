{
  "name": "i360-md",
  "private": true,
  "description": "i360 Markdown Reader and i360 CSE",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "inventory": "node --env-file=.env indexer/inventory.js",
    "index": "node --env-file=.env indexer/build-index.js",
    "publish-lib": "npx --yes wrangler@4.145.0 deploy",
    "search": "node indexer/search.js"
  },
  "devDependencies": {
    "marked": "18.1.0"
  },
  "engines": {
    "node": ">=20.6"
  }
}

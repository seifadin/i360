{
  "name": "i360-hub",
  "private": true,
  "type": "module",
  "description": "i360 hub: Daily Reflection, Markdown Reader and i360 CSE",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "eslint . && node --test test/*.test.js",
    "lint": "eslint .",
    "inventory": "node --env-file=.env indexer/inventory.js",
    "index": "node --env-file=.env indexer/build-index.js",
    "publish-lib": "npx --yes wrangler@4.151.3 deploy",
    "publish-theme": "npx --yes wrangler@4.151.3 deploy --config theme/wrangler.jsonc",
    "publish-hijri": "npx --yes wrangler@4.151.3 deploy --config hijri/wrangler.jsonc",
    "deploy-forwarders": "firebase deploy --only hosting:hub,hosting:md,hosting:cse,hosting:day && firebase deploy --only hosting:e --project i360-e",
    "fonts-check": "node theme/fonts.js",
    "icons": "node scripts/icons.js",
    "push": "node scripts/push.js",
    "search": "node indexer/search.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "adhan": "4.4.6",
    "autoprefixer": "10.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "lucide-static": "^1.21.0",
    "marked": "18.1.0",
    "tailwindcss": "3.4.19"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}

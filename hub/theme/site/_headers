# theme.i36o.workers.dev — read by every i360 app, from any site.
# A header set by two matching rules is joined with a comma, so Cache-Control
# is set by exactly one rule per path.
/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/theme.css
  Cache-Control: no-cache

/theme-loader.js
  Cache-Control: no-cache

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

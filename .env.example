VITE_BASEROW_KEY=your_baserow_api_key_here
VITE_BASEROW_URL=https://api.baserow.io/api/database/rows/table/
VITE_BASEROW_TABLE_SCIENCES=193269
VITE_BASEROW_TABLE_RESOURCES=193270
VITE_BASEROW_TABLE_QURAN=488824
VITE_TRANSLATOR_KEY=your_ms_translator_key_here
VITE_TRANSLATOR_URL=https://api.cognitive.microsofttranslator.com/translate
VITE_PSE_CX=your_google_pse_cx_here

# Used only by scripts/pre-push-hook.sh's update_baserow_version(), never
# by the client app — deliberately separate from VITE_BASEROW_KEY, which
# stays read-only. Must NOT get a VITE_ prefix, or it would bake into the
# public client bundle the same way OTAKIT_TOKEN's own rule works.
BASEROW_WRITE_KEY=your_write_capable_baserow_token_here
# The specific row within i360dbc (table 193270) whose Version field
# gets updated on a real store submission — find this via Baserow's own
# UI (the row's own ID, not a field ID).
BASEROW_I360DBC_ROW_ID=your_row_id_here
